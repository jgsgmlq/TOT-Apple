# 只在开发模式中被载入
VITE_PORT = 8001

VITE_GLOB_APP_TITLE = TOT
VITE_GLOB_APP_SHORT_NAME = TOT

# 网站根目录
VITE_PUBLIC_PATH = /

# 是否开启控制台打印 mock 请求信息
VITE_LOGGER_MOCK = true

# 是否删除console
VITE_DROP_CONSOLE = true

# 跨域代理，可以配置多个，请注意不要换行
#VITE_PROXY = [["/appApi","http://localhost:8001"],["/upload","http://localhost:8001/upload"]]
#VITE_PROXY=[["/api","https://naive-ui-admin"]]

# ToT 后端 API 地址（开发环境）
# ─────────────────────────────────────────────────────────────────
# 【推荐】留空：请求走「当前页面同源 + Vite 代理 → 本机 :3000」。
#   - 本机浏览器、Tailscale 内网、手机经 Tailscale Funnel 访问均可正常联调。
#   - 若填 http://100.x.x.x:3000，手机用蜂窝打开 Funnel 页面时 API 会指向不可达的 100 段，页面会一直加载。
#
# 仅在特殊情况下改为直连后端（例如调试代理问题时）：
#   VITE_GLOB_API_URL=http://127.0.0.1:3000
#   或 Mac Studio：VITE_GLOB_API_URL=http://<Tailscale IP>:3000
VITE_GLOB_API_URL=
# ─────────────────────────────────────────────────────────────────

# 接口前缀（与文档基础路径 /api/v1 一致）
VITE_GLOB_API_URL_PREFIX = /api/v1

# 联调后端时请设为 false
VITE_USE_MOCK = false

# 手机 + Tailscale Funnel 若首屏一直加载：复制 .env.development.local.example 为 .env.development.local 并保留 VITE_FUNNEL_MODE=1

# 文件上传地址
VITE_GLOB_UPLOAD_URL=

# 文件前缀地址
VITE_GLOB_FILE_URL=
