# 只在开发模式中被载入
VITE_PORT = 8001

VITE_GLOB_APP_TITLE = TOT
VITE_GLOB_APP_SHORT_NAME = TOT

# 网站根目录
VITE_PUBLIC_PATH = /

# 是否开启控制台打印 mock 请求信息
VITE_LOGGER_MOCK = true

# 是否删除console
VITE_DROP_CONSOLE = true

# 跨域代理，可以配置多个，请注意不要换行
#VITE_PROXY = [["/appApi","http://localhost:8001"],["/upload","http://localhost:8001/upload"]]
#VITE_PROXY=[["/api","https://naive-ui-admin"]]

# ToT 后端（默认本机）；联调时关闭 mock，请求将直连此处
# 手机浏览器访问本机前端时，localhost 指向手机，接口会失败；请改为本机局域网 IP，例如：
# VITE_GLOB_API_URL = http://17.87.10.71:3000
# （IP 以运行 npm run dev 时终端里 Network 行为准，会随 WiFi 变化）
VITE_GLOB_API_URL = http://172.20.10.2:3000

# 接口前缀（与文档基础路径 /api/v1 一致）
VITE_GLOB_API_URL_PREFIX = /api/v1

# 联调后端时请设为 false
VITE_USE_MOCK = false

# 文件上传地址
VITE_GLOB_UPLOAD_URL=

# 文件前缀地址
VITE_GLOB_FILE_URL=
