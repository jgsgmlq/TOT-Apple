# 只在开发模式中被载入
VITE_PORT = 8001

VITE_GLOB_APP_TITLE = TOT
VITE_GLOB_APP_SHORT_NAME = TOT

# 网站根目录
VITE_PUBLIC_PATH = /

# 是否开启控制台打印 mock 请求信息
VITE_LOGGER_MOCK = true

# 是否删除console
VITE_DROP_CONSOLE = true

# 跨域代理，可以配置多个，请注意不要换行
#VITE_PROXY = [["/appApi","http://localhost:8001"],["/upload","http://localhost:8001/upload"]]
#VITE_PROXY=[["/api","https://naive-ui-admin"]]

# ToT 后端 API 地址
# ─────────────────────────────────────────────────────────────────
# 【本地开发，仅使用本机后端】：
#   VITE_GLOB_API_URL = http://localhost:3000
#
# 【连接 Mac Studio 共享服务器】（推荐，支持外网/移动网络）：
#   1. 安装 Tailscale 并加入团队 Network（见 TOT_backend/docs/team-onboarding.md）
#   2. 执行 `tailscale ip -4` 获取 Mac Studio 的 Tailscale IP
#   3. 填入下方（每人本地填自己的，不要 commit 这行）：
VITE_GLOB_API_URL = http://100.x.x.x:3000
#
# 【手机真机调试】：同上，Tailscale IP 即可，无需局域网同 WiFi
# ─────────────────────────────────────────────────────────────────

# 接口前缀（与文档基础路径 /api/v1 一致）
VITE_GLOB_API_URL_PREFIX = /api/v1

# 联调后端时请设为 false
VITE_USE_MOCK = false

# 文件上传地址
VITE_GLOB_UPLOAD_URL=

# 文件前缀地址
VITE_GLOB_FILE_URL=
