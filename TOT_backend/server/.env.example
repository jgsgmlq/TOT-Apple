# 实际加载顺序见 `server/app.js`：先仓库根目录 `.env`，再 `TOT_backend/.env`（仅补全未定义键）。
# 内部联调请优先使用根目录 `.env.example` 中的 MYPAL_MOCK=1。
#
# 真实 MyPal HTTP（与 Mock 二选一；内部联调勿启用）：
# MYPAL_ENABLED=1
# MYPAL_API_BASE=https://your-mypal-domain
# MYPAL_APP_ID=
# MYPAL_APP_SECRET=

# ─── AI Debugging Logging ─────────────────────────────────
# 设置为 `true` 时，AI 的完整输入输出将记录在 server/logs/ai_debug.log 中。
DEBUG_AI_LOG=false

# ─── Langfuse Tracing (LLM Observability) ──────────────────
# 运行期总开关，设为 true 且配置 Key 后生效，否则自动降级为 NoopTrace
LANGFUSE_ENABLED=false
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...
LANGFUSE_BASEURL=https://cloud.langfuse.com
# 采样率：1.0 表示全量，生产建议 0.1~0.3（按 sessionId 哈希分桶）
LANGFUSE_SAMPLE_RATE=1.0
# 是否在上报前对手机号、邮箱等 PII 数据进行脱敏
LANGFUSE_MASK_PII=true
