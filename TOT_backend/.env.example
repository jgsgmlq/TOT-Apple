# 复制本文件为项目根目录下的 `.env` 后填写真实值。
# `.env` 已被 .gitignore 忽略，请勿将密钥提交到 Git。
#
# 后端启动：`cd server && npm start`
# 环境变量在 `server/app.js` 中通过 dotenv 从**仓库根目录**的 `.env` 加载。

# ─── HTTP ─────────────────────────────────────────────────
# 服务监听端口（可选，默认 3000）
PORT=3000

# 进程时区（影响「本地墙钟」时间与 SQLite datetime('now', 'localtime')；生产建议 Asia/Shanghai）
# TZ=Asia/Shanghai

# ─── JWT（登录态签名）──────────────────────────────────────
# 生产环境务必改为足够长的随机字符串；开发可留空使用代码内默认占位
JWT_SECRET=

# ─── DeepSeek（OpenAI 兼容 API，可选）───────────────────────
# 用于 Agent 技能 `generate_*_deepseek` 等；不配置则相关调用会报错。
# 申请：https://platform.deepseek.com
DEEPSEEK_API_KEY=

# ─── 自动预警定时调度（可选）────────────────────────────────
# 服务启动时挂载；对「已下发且已配置 auto_nudge_rules」的任务周期性执行 evaluateAndTriggerAutoNudges。
# AUTO_NUDGE_SCHEDULER=0  — 关闭定时调度（仍可通过 POST /api/v1/tasks/:id/auto-nudge 手动触发）
# AUTO_NUDGE_INTERVAL_MS   — 间隔毫秒，默认 3600000（1 小时）；开发联调可设为 3000 等短间隔
# AUTO_NUDGE_SCHEDULER=
# AUTO_NUDGE_INTERVAL_MS=

# ─── MyPal（内部联调：本地 Mock，推荐）────────────────────────────────────────
# 设为 `1` 启用 `GET /api/v1/mypal/mock/learning`，数据来自表 `mypal_learning_mock`（seed 生成）。
# 内部阶段保持此项即可；勿同时打开下方「真实 HTTP」除非已与 MyPal 开通联调。
MYPAL_MOCK=1

# ─── MyPal（真实 HTTP，与 Mock 二选一；内部联调请留空）───────────────────────
# MYPAL_ENABLED=1
# MYPAL_API_BASE=https://your-mypal-domain
# MYPAL_APP_ID=
# MYPAL_APP_SECRET=
# MYPAL_REQUEST_TIMEOUT_MS=3000

# ─── EChat Agent 模式（可选）────────────────────────────────
# 控制 Executive Chat 的 AI Agent 运行模式，影响 POST /api/v1/chat/executive/sessions/:id/messages。
# intent_routing（默认）— MVP 双阶段流程：LLM 先分类意图 → 同步查询 DB → LLM 再格式化答复；
#                          无需额外配置，开箱即用。
# function_calling       — Function Calling 升级模式：由 LLM 自行决策调用哪些工具，支持复合查询；
#                          切换前请确保 DEEPSEEK_API_KEY 已配置且模型支持 FC。
# 修改后需重启服务器生效。
# CHAT_AGENT_MODE=intent_routing
