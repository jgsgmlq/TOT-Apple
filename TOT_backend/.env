# 可与仓库根目录 `.env` 二选一或并存：`app.js` 先加载根目录 `.env`，再加载本文件（仅补全未定义键）。
# `.env` 已被 .gitignore 忽略，请勿将密钥提交到 Git。
#
# 后端启动：`cd server && npm start`

# ─── HTTP ─────────────────────────────────────────────────
# 服务监听端口（可选，默认 3000）
PORT=3000

# ─── JWT（登录态签名）──────────────────────────────────────
# 生产环境务必改为足够长的随机字符串；开发可留空使用代码内默认占位
JWT_SECRET=

# ─── 语音转写 ASR（阿里云百炼 OpenAI 兼容模式，可选）──────────────────────────
# 用于 POST /api/v1/asr/transcribe；密钥见：https://help.aliyun.com/zh/model-studio/get-api-key
# 未配置时调用接口返回 503（ASR_001）。也可使用百炼同名变量 DASHSCOPE_API_KEY。
ASR_API_KEY=sk-b0f1a373bd514f59a75784175671a90d

# ─── DeepSeek（OpenAI 兼容 API，可选）───────────────────────
# 用于 Agent 技能 `generate_*_deepseek` 等；不配置则相关调用会报错。
# 申请：https://platform.deepseek.com
DEEPSEEK_API_KEY=sk-da374e41ad4f411c8406785809632c87 

# ─── MyPal（开发环境 Mock）─────────────────────────────────────────────────
# 设置为 `1` 时启用：
# - `GET /api/v1/mypal/mock/learning`
# 并使用本地 SQLite 的开发专用表 `mypal_learning_mock` 进行联调数据返回。
MYPAL_MOCK=1

# ─── MyPal（真实 HTTP 联调）───────────────────────────────────────────────
# `/api/v1/mypal/sync` 需要以下配置；修改后重启后端生效。
MYPAL_ENABLED=1
MYPAL_API_BASE=https://test.mymax.cn
MYPAL_APP_ID=maxtot260401
MYPAL_APP_SECRET=6dc8e66203cde881396add4dfd08262f
MYPAL_REQUEST_TIMEOUT_MS=3000

# ─── EChat Agent 模式（可选）────────────────────────────────
# 控制 Executive Chat 的 AI Agent 运行模式，影响 POST /api/v1/chat/executive/sessions/:id/messages。
# intent_routing（默认）— MVP 双阶段流程：LLM 先分类意图 → 同步查询 DB → LLM 再格式化答复；
#                          无需额外配置，开箱即用。
# function_calling       — Function Calling 升级模式：由 LLM 自行决策调用哪些工具，支持复合查询；
#                          切换前请确保 DEEPSEEK_API_KEY 已配置且模型支持 FC。
# 修改后需重启服务器生效。
CHAT_AGENT_MODE=function_calling

# ─── AI Debugging Logging ─────────────────────────────────
# 设置为 `true` 时，AI 的完整输入输出将记录在 server/logs/ai_debug.log 中。
DEBUG_AI_LOG=true

E2B_API_KEY=e2b_d20096fd92a2e512f51bfa07cfb12226b71c633c


# ─── Langfuse (Executive Chat Telemetry，可选) ────────────────────────────────
# 接入计划：docs/plans/2026-04-23-agent-execution-telemetry.md
# 未配置密钥或 LANGFUSE_ENABLED != "true" 时，tracer.js 降级为 no-op，不影响主流程。
LANGFUSE_SECRET_KEY="sk-lf-0cd227dc-d327-4c53-8f17-62852b24b4ee"
LANGFUSE_PUBLIC_KEY="pk-lf-c9df47ae-f4da-4530-81f6-3c4b350de589"
# 注意：变量名是 LANGFUSE_BASEURL（SDK 约定，无下划线）。US 区请与密钥区域对应。
LANGFUSE_BASEURL="https://us.cloud.langfuse.com"
# 运行期总开关（降级 no-op 用）
LANGFUSE_ENABLED="true"
# 生产建议 0.1~0.3；按 sessionId 哈希分桶，保证同一会话 trace 连贯
LANGFUSE_SAMPLE_RATE="1.0"
# 上报前是否对 user/tool args / reasoning 摘要做 PII 脱敏
LANGFUSE_MASK_PII="true"